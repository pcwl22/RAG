# 环境变量配置文件
# 复制此文件为 .env 并填入真实的 API 密钥
RAG_API_KEY=7ea6b5a98a39aa49fdf3401838c75bd5810a0a2e947d52e8e68d03eb34086f45
# =============================================================================
# 配置环境
# =============================================================================
# 使用哪个配置文件：laptop（笔记本，默认）或 base（生产环境）
RAG_ENV=laptop

# =============================================================================
# LLM API 配置（至少配置一个）
# =============================================================================

# DeepSeek API（推荐：性价比最高）

#DEEPSEEK_MODEL=deepseek-v4-pro-0813
#DEEPSEEK_MODEL=deepseek-v4-flash-0731
#DEEPSEEK_API_KEY=REPLACE_WITH_MODEL_API_KEY
#DEEPSEEK_API_URL=https://elysiver.h-e.top

#DEEPSEEK_MODEL=deepseek-v4-flash
#DEEPSEEK_API_KEY=REPLACE_WITH_MODEL_API_KEY
#DEEPSEEK_API_URL=https://ioll.pp.ua

DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=REPLACE_WITH_MODEL_API_KEY

# =============================================================================
# 数据库配置
# =============================================================================
# PostgreSQL 配置（本地安装）
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=postgres

# Redis 配置（可选，用于语义缓存）
# 如果没有 Redis，系统会自动禁用缓存功能，不影响使用
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# 其他配置（通常不需要修改）
# =============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# API 服务端口
# API_PORT=8000

# =============================================================================
# 提示
# =============================================================================
# 1. 至少配置一个 LLM API 密钥（Claude、DeepSeek 或智谱）
# 2. 配置 provider 在 configs/laptop.yaml 的 llm.text.provider
# 3. Redis 非必需，没有时自动禁用缓存
# 4. 模型文件需手动下载到 E:/RAG/models/ 目录

