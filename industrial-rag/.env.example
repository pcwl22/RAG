# 环境变量配置文件
# 复制此文件为 .env 并填入真实的 API 密钥

# =============================================================================
# 配置环境
# =============================================================================
# 使用哪个配置文件：laptop（笔记本，默认）或 base（生产环境）
RAG_ENV=laptop
RAG_API_KEY=change-me-in-development
RAG_METRICS_TOKEN=change-me-with-a-separate-strong-token
RAG_SERVICE_TENANT_ID=00000000-0000-0000-0000-000000000001
RAG_SERVICE_ROLES=viewer
OIDC_ENABLED=false
COMPOSE_OIDC_ENABLED=true
OIDC_ISSUER=http://localhost:18080/realms/industrial-rag
OIDC_AUDIENCE=rag-api
OIDC_JWKS_URL=http://localhost:18080/realms/industrial-rag/protocol/openid-connect/certs
OIDC_INTERNAL_JWKS_URL=http://keycloak:8080/realms/industrial-rag/protocol/openid-connect/certs
VITE_OIDC_ISSUER=http://localhost:18080/realms/industrial-rag
VITE_OIDC_CLIENT_ID=rag-frontend
VITE_OIDC_AUDIENCE=rag-api
OIDC_CONNECT_SRC=http://localhost:18080
RAG_BIND_ADDRESS=127.0.0.1
RAG_FRONTEND_PORT=5173
QUEUE_PROVIDER=memory
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# =============================================================================
# LLM API 配置（至少配置一个）
# =============================================================================

# Claude API（推荐：质量最高，支持多模态）
# 注册地址: https://console.anthropic.com/
# 费用: 约 $3/1M input tokens, $15/1M output tokens
CLAUDE_API_KEY=sk-ant-xxxxx

# DeepSeek API（推荐：性价比最高）
# 注册地址: https://platform.deepseek.com/
# 费用: 约 $0.14/1M input tokens, $0.28/1M output tokens
DEEPSEEK_API_KEY=sk-xxxxx

# 智谱 AI（国内稳定）
# 注册地址: https://open.bigmodel.cn/
# 费用: 约 ¥0.005/1k tokens
ZHIPU_API_KEY=xxxxx.xxxxx

# =============================================================================
# 数据库配置
# =============================================================================
# PostgreSQL 配置（用于混合检索）
POSTGRES_PASSWORD=change-me
POSTGRES_RUNTIME_USER=rag_runtime
POSTGRES_APP_PASSWORD=change-me-runtime-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-before-starting-identity
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rag_db
# POSTGRES_USER=postgres

# Redis 配置。本机 laptop profile 可在 Redis 不可用时自动禁用缓存；
# base/生产 profile 必须使用带密码的 URL。跨主机生产部署应使用 rediss://。
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@localhost:16379/0
COMPOSE_REDIS_URL=redis://:change-me-redis-password@redis:6379/0
REDIS_REQUIRE_TLS=false

# =============================================================================
# 其他配置（通常不需要修改）
# =============================================================================
# 日志级别: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# API 服务端口
# API_PORT=8000

# =============================================================================
# 提示
# =============================================================================
# 1. 至少配置一个 LLM API 密钥（Claude、DeepSeek 或智谱）
# 2. 配置 provider 在 config/laptop.yaml 的 llm.text.provider
# 3. Redis 非必需，没有时自动禁用缓存
# 4. 模型文件需手动下载到 E:/RAG/models/ 目录
