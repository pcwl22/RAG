# syntax=docker/dockerfile:1.7
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS build
WORKDIR /app
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_AUDIENCE
ENV VITE_OIDC_ISSUER=${VITE_OIDC_ISSUER} \
    VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID} \
    VITE_OIDC_AUDIENCE=${VITE_OIDC_AUDIENCE}
COPY rag-frontend/package.json rag-frontend/package-lock.json ./
RUN npm ci
COPY rag-frontend/ ./
RUN npm run build

FROM nginx:1.30.5-alpine3.24@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
ARG SOURCE_REVISION
ARG SOURCE_REPOSITORY
LABEL org.opencontainers.image.revision=$SOURCE_REVISION \
      org.opencontainers.image.source=$SOURCE_REPOSITORY
COPY rag-frontend/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
RUN apk add --no-cache --upgrade 'libexpat=2.8.5-r0' \
    && sed -i 's/listen 80;/listen 8080;/' /etc/nginx/templates/default.conf.template \
    && sed -i 's|^pid[[:space:]].*;|pid /tmp/nginx.pid;|' /etc/nginx/nginx.conf \
    && sed -i '/^user[[:space:]]/d' /etc/nginx/nginx.conf \
    && mkdir -p /var/cache/nginx /var/run /etc/nginx/conf.d \
    && chown -R nginx:nginx /var/cache/nginx /var/run /etc/nginx/conf.d /usr/share/nginx/html
USER 101:101
EXPOSE 8080
