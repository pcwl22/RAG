# syntax=docker/dockerfile:1.7
# MODEL_BUNDLE_IMAGE is a signed, digest-pinned descriptor image. It contains
# only /models/model-manifest.json and never contains model weights.
ARG MODEL_BUNDLE_IMAGE
FROM ${MODEL_BUNDLE_IMAGE} AS model_bundle

FROM ghcr.io/pytorch/pytorch:2.14.0-cuda12.6-cudnn9-runtime@sha256:ac7effd0cd05c10c7ae8458b7c864fea6eaccfed31123db648bb080085635901

ARG SOURCE_REVISION
ARG SOURCE_REPOSITORY
ARG MODEL_BUNDLE_DIGEST
ARG MODEL_MANIFEST_SHA256
LABEL org.opencontainers.image.revision=$SOURCE_REVISION \
      org.opencontainers.image.source=$SOURCE_REPOSITORY \
      org.opencontainers.image.model-bundle-digest=$MODEL_BUNDLE_DIGEST \
      org.opencontainers.image.model-manifest-sha256=$MODEL_MANIFEST_SHA256

WORKDIR /app
ENV PIP_DEFAULT_TIMEOUT=1000 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG SECURITY_REFRESH=2026-09-21

RUN set -eu; \
    test -n "${SECURITY_REFRESH}"; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=120 update; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=120 \
        install -y --no-install-recommends --only-upgrade linux-libc-dev; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=120 install -y --no-install-recommends \
        build-essential git libpoppler-cpp-dev python3-venv tesseract-ocr \
        tesseract-ocr-chi-sim tesseract-ocr-chi-tra libreoffice; \
    rm -rf /var/lib/apt/lists/*

# GHCR's official runtime follows PEP 668. Keep the base Torch installation
# visible while installing application dependencies into an isolated prefix.
RUN python -m pip uninstall --break-system-packages --yes \
        pillow spin torchaudio torchvision \
    && python -m pip check
RUN python -m venv --system-site-packages /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

COPY pyproject.toml README.md requirements-runtime.lock.txt ./
RUN python -c "import torch; assert torch.__version__.split('+', 1)[0] == '2.13.0'; assert str(torch.version.cuda).startswith('12.6')" \
    && pip install --no-cache-dir --require-hashes -r requirements-runtime.lock.txt
ENV PYTHONPATH=/app
COPY app/ ./app/
COPY scripts/validate_model_bundle_manifest.py ./scripts/validate_model_bundle_manifest.py
RUN python -m pip check
COPY prompts/ ./prompts/
COPY config/ ./config/
COPY --from=model_bundle /models/model-manifest.json /app/model-source-manifest.json

ENV MODEL_MANIFEST_PATH=/app/model-source-manifest.json \
    HF_ENDPOINT=https://huggingface.co \
    HF_HUB_DISABLE_TELEMETRY=1

RUN test -f /app/model-source-manifest.json \
    && python scripts/validate_model_bundle_manifest.py /app/model-source-manifest.json \
    && mkdir -p /app/data /app/logs /app/models \
    && groupadd --gid 10001 appgroup \
    && useradd --create-home --uid 10001 --gid 10001 --no-log-init appuser \
    && chown -R 10001:10001 /app
USER 10001:10001
EXPOSE 8000
CMD ["gunicorn", "app.main:app", "--workers", "1", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "120", "--keep-alive", "5", "--access-logfile", "-", "--error-logfile", "-"]
