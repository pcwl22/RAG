{
  "realm": "industrial-rag",
  "enabled": true,
  "displayName": "Industrial RAG",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Query and view tenant documents" },
      { "name": "editor", "description": "Upload tenant documents" },
      { "name": "admin", "description": "Delete and administer tenant documents" }
    ]
  },
  "clients": [
    {
      "clientId": "rag-api",
      "name": "Industrial RAG API",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "enabled": true
    },
    {
      "clientId": "rag-frontend",
      "name": "Industrial RAG Frontend",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:15173/*",
        "http://127.0.0.1:15173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:15173",
        "http://127.0.0.1:15173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://127.0.0.1:5173/*##http://localhost:15173/*##http://127.0.0.1:15173/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "user.attribute": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "rag-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "rag-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
